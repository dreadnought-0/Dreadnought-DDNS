# DEMO MODE CONFIGURATION
# This is the example/demo branch. These are intentionally public demo credentials.

# Cloudflare API Token (not used in demo mode - no real API calls are made)
CF_API_TOKEN=DEMO_MODE_ONLY

# Admin User Configuration
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=admin

# Security
SECRET_KEY=demo-secret-key-not-for-production-use

# Sync Configuration
POLL_INTERVAL_SECONDS=300

# IPv6 Support
IPV6_ENABLED=false

# Discord Webhook URL (disabled for demo)
DISCORD_WEBHOOK_URL=

# Timezone
TZ=America/Denver
